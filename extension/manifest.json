{
  "manifest_version": 3,
  "name": "Nemesis — bring in your coursework",
  "version": "0.2.0",
  "description": "Reads the courses and syllabus files already on your school portal, so Nemesis can set up your semester. Read-only.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://app.enternemesis.com/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Nemesis",
    "default_popup": "dist/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://app.enternemesis.com/*", "http://localhost:3200/*", "http://localhost:3000/*"],
      "js": ["dist/content-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
