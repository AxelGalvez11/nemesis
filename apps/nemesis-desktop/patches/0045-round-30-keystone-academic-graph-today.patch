-            .split(/\r?\n/)
-            .filter(line => !line.trim().startsWith('#'))
-            .join('\n');
-        const cards = parseCardPaste(body);
-        out.push({
-            cards,
-            course: courseMatch?.[1]?.trim(),
-            fileName: entry.name,
-            name: entry.name.replace(/\.(tsv|txt|md)$/i, '')
-        });
-    }
-    return out;
-}
