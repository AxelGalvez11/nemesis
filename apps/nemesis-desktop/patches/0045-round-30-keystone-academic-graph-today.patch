+}
+
+function overdueObjects(graph: AcademicGraph, todayKey: string): AcademicObject[] {
+  return graph.objects.filter(
+    object =>
+      DUE_TYPES.has(object.type) &&
+      Boolean(object.date) &&
+      object.date!.slice(0, 10) < todayKey &&
+      !CLOSED_STATUSES.has(object.status ?? '')
