+        <button
+          className={cn(
+            'truncate rounded-lg py-1.5 text-left text-[0.8125rem] text-(--ui-text-secondary) transition-colors duration-200 ease-out hover:bg-(--ui-row-hover-background) hover:text-foreground active:scale-[0.98]',
