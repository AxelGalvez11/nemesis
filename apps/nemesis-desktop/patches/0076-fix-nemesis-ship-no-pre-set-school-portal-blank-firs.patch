Subject: [PATCH] =?UTF-8?q?fix(nemesis):=20ship=20no=20pre-set=20school=20?=
 =?UTF-8?q?portal=20=E2=80=94=20blank=20first-run=20default?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A fresh install inherited the owner's own LMS/email (blackboard.uthsc.edu +
Outlook), so any non-UTHSC student who clicked through onboarding got an agent
pointed at the wrong school. Default is now empty; the student connects their
own portals in onboarding Step 1 / Settings → Connections. All consumers
(connections UI, school-sync scheduler) are empty-safe. Existing installs are
unaffected (saved portals live in localStorage).
---
 .../src/app/today/school-sync-schedule.js     |  3 ++-
 .../src/app/today/school-sync-schedule.ts     |  3 ++-
 apps/desktop/src/lib/school-portals.js        | 26 ++++++-------------
 apps/desktop/src/lib/school-portals.ts        | 26 ++++++-------------
 4 files changed, 20 insertions(+), 38 deletions(-)

diff --git a/apps/desktop/src/app/today/school-sync-schedule.js b/apps/desktop/src/app/today/school-sync-schedule.js
index 7b559bb89e8..2c6a16283f4 100644
--- a/apps/desktop/src/app/today/school-sync-schedule.js
+++ b/apps/desktop/src/app/today/school-sync-schedule.js
@@ -12,7 +12,8 @@ const LAST_NUDGE_KEY = 'nemesis.school.autosync.lastNudge.v1';
 export const SYNC_HOURS_TWICE = [8, 18];
 export const SYNC_HOURS_DAILY = [8];
 // The student's configured portals (LMS + school email) — per-student, editable
-// in Settings → Connections, defaulting to the owner's school on first run.
+// in Settings → Connections. Empty until the student connects their own; a fresh
+// install ships with no pre-set school (see DEFAULT_SCHOOL_PORTALS).
 export function schoolPortals() {
     return loadSchoolPortals();
 }
