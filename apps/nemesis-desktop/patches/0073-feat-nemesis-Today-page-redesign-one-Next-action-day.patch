+    const key = object.date?.slice(0, 10);
+    if (!key) {
+        return 'undated';
+    }
+    if (key < todayKey) {
+        return 'overdue';
+    }
+    if (key === todayKey) {
+        return 'today';
+    }
+    const today = parseDateKey(todayKey);
+    const tomorrow = new Date(today.getFullYear(), today.getMonth(), today.getDate() + 1);
+    if (key === dateKey(tomorrow)) {
