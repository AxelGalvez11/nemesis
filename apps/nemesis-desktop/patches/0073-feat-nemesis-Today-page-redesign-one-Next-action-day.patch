+}
+function needsAttention(overdue, upcoming, inbox, todayKey) {
+    const objects = new Map();
+    for (const object of [...overdue, ...upcoming, ...inbox]) {
+        if (!objects.has(object.id)) {
+            objects.set(object.id, object);
+        }
+    }
+    const bucketRank = {
+        overdue: 0,
+        today: 1,
+        tomorrow: 2,
+        later: 3,
+        undated: 4
+    };
+    return [...objects.values()]
