From 5b6e0635f32e64f20648c67cdaa9484abe6c16e9 Mon Sep 17 00:00:00 2001
From: AxelGalvez11 <axelgalvez1121@gmail.com>
Date: Sat, 11 Jul 2026 18:29:22 -0500
Subject: [PATCH 3/4] =?UTF-8?q?fix(nemesis-kit):=20round-34c=20=E2=80=94?=
 =?UTF-8?q?=20mind=20maps=20were=20completely=20inert?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Root cause: overflowHidden: true makes mind-elixir SKIP binding its entire
pointer-interaction system (the option's ternary either sets overflow:hidden
or installs handlers — never both). Removed it; interactions verified live via
synthetic PointerEvents: node click -> selection + Explanation panel; drag ->
node re-parented + layout persisted to localStorage.
---
 apps/desktop/src/app/study/mindmap-viewer.js  | 4 +++-
 apps/desktop/src/app/study/mindmap-viewer.tsx | 4 +++-
 2 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/apps/desktop/src/app/study/mindmap-viewer.js b/apps/desktop/src/app/study/mindmap-viewer.js
index 4dcc0198e35..e5e22a6c1e1 100644
--- a/apps/desktop/src/app/study/mindmap-viewer.js
+++ b/apps/desktop/src/app/study/mindmap-viewer.js
@@ -194,7 +194,9 @@ function MindmapCanvas({ file }) {
                 editable: true,
                 el: host,
                 keypress: false,
-                overflowHidden: true,
+                // NEVER set overflowHidden: true — mind-elixir treats it as "the host manages
+                // interaction" and skips binding its mouse handlers entirely (no drag/click/pan).
+                mouseSelectionButton: 0,
                 theme: MINDMAP_THEME,
                 toolBar: false
             });
diff --git a/apps/desktop/src/app/study/mindmap-viewer.tsx b/apps/desktop/src/app/study/mindmap-viewer.tsx
index 9a0b32af04a..7bf8827a461 100644
--- a/apps/desktop/src/app/study/mindmap-viewer.tsx
+++ b/apps/desktop/src/app/study/mindmap-viewer.tsx
@@ -280,7 +280,9 @@ function MindmapCanvas({ file }: { file: MindmapFile }) {
         editable: true,
         el: host,
         keypress: false,
-        overflowHidden: true,
+        // NEVER set overflowHidden: true — mind-elixir treats it as "the host manages
+        // interaction" and skips binding its mouse handlers entirely (no drag/click/pan).
+        mouseSelectionButton: 0,
         theme: MINDMAP_THEME,
         toolBar: false
       })
