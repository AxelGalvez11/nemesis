Date: Mon, 13 Jul 2026 23:31:28 -0500
Subject: [PATCH] =?UTF-8?q?fix(install):=20explicit=20macOS=20browser=20ca?=
 =?UTF-8?q?se=20=E2=80=94=20Chromium=20installs=20cleanly,=20no=20false=20?=
 =?UTF-8?q?warning?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

macOS previously hit the generic fallback: it warned 'browser tools will not
work until dependencies are installed' and then downloaded Chromium anyway
with the outcome swallowed. Browser automation ships working out of the box
on macOS; a real failure now prints the exact retry command.
---
 scripts/install.sh | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/scripts/install.sh b/scripts/install.sh
index 9af10b80553..9fcf6940a84 100755
--- a/scripts/install.sh
+++ b/scripts/install.sh
@@ -2216,6 +2216,15 @@ install_node_deps() {
                         log_warn "Playwright browser installation failed — install dependencies above and retry."
                     }
                     ;;
+                macos)
+                    # macOS needs no system-dep step: the Chromium download alone
+                    # is sufficient, so browser tools work out of the box.
+                    cd "$INSTALL_DIR" && run_playwright_install 600 npx playwright install chromium && \
+                        log_success "Chromium installed — browser tools ready" || {
+                        log_warn "Chromium download failed — browser tools disabled until you run:"
+                        log_info "  cd $INSTALL_DIR && npx playwright install chromium"
+                    }
+                    ;;
                 *)
                     log_warn "Playwright does not support automatic dependency installation on $DISTRO."
                     log_info "Install Chromium/browser system dependencies for your distribution, then run:"
