+  })
+
+  it('never reports garbage as newer (fail-safe: no banner)', () => {
+    expect(isNewerVersion('latest', '0.1.0-beta.1')).toBe(false)
+    expect(isNewerVersion('', '0.1.0-beta.1')).toBe(false)
