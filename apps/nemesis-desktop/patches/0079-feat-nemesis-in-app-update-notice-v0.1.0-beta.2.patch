+    expect(isNewerVersion('1.0.0', '0.9.9')).toBe(true)
+    expect(isNewerVersion('0.1.0', '0.1.0')).toBe(false)
+    expect(isNewerVersion('0.1.0', '0.1.1')).toBe(false)
+  })
