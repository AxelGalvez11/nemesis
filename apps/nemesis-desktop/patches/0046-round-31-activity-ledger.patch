+  return new Date(ts).toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit', second: '2-digit' })
+}
+
+function LedgerRow({ entry }: { entry: LedgerEntry }) {
+  const externalAction = entry.sent === true || entry.submitted === true
+
