# Nemesis web account and research workspace.
NEXT_PUBLIC_SUPABASE_URL=https://qyjmivntajbigjswhahb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_LANDING_URL=https://www.enternemesis.com

# PostHog product analytics. The phc_ project key is a PUBLIC write-only ingestion key (safe in the
# browser bundle). The agent/dashboards READ analytics with a separate personal API key, never this.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server-only. Never expose these as NEXT_PUBLIC_*.
# DeepSeek key for vision (lib/vision/deepseek.ts) — reading photos, slides, handwriting.
# Without it every image read falls back to Gemini. DEEPSEEK_VISION_MODEL overrides the
# default model id for the day the experimental one is renamed.
DEEPSEEK_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_PRICE_ID=
STRIPE_PRO_PRICE_ID=
# Recurring monthly Stripe Price for Nemesis Max at exactly $99 USD.
STRIPE_MAX_PRICE_ID=
# Comma-separated retired Max Price IDs whose existing subscribers remain grandfathered.
STRIPE_MAX_LEGACY_PRICE_IDS=
# Production billing is live-only. For an isolated local/test Supabase project,
# test Stripe writers also require STRIPE_ALLOW_TEST_BILLING=true.
STRIPE_ALLOW_TEST_BILLING=false
# Set true only when deliberately going live.
STRIPE_ALLOW_LIVE=false

# Live audio copilot. The API key remains server-only; the browser receives a
# one-time AssemblyAI token after Nemesis reserves the user's metered window.
ASSEMBLYAI_API_KEY=
# Cost-first default. Set u3-rt-pro only after a measured quality evaluation.
ASSEMBLYAI_SPEECH_MODEL=universal-streaming-multilingual

# ── Azure Speech ────────────────────────────────────────────────────────────
# Multilingual neural TTS for the language-learning lane, and the pronunciation
# assessment engine. SERVER-SIDE ONLY — never prefix either of these with
# NEXT_PUBLIC_. The browser gets a short-lived token from /api/speech/token, and
# apps/web/lib/speech/azure/config.ts is the only file that reads the key.
# Absent ⇒ pronunciation scoring reports "not configured" and the language lane
# falls back to xAI's `auto` voice. Nothing else changes.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
