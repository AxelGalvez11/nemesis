{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "paths": {
      "@nemesis/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@/lib/supabase": [
        "./src/api/supabase"
      ],
      "@/*": [
        "./src/*",
        "../web/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".expo",
    "e2e",
    "**/*.test.ts"
  ]
}
