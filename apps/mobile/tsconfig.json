{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/*"],
      "@nemesis/shared/bloub/*": ["../../packages/shared/src/bloub/*.ts"],
      "@nemesis/shared/character/*": ["../../packages/shared/src/character/*.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "dist", ".expo", "e2e", "**/*.test.ts"]
}
