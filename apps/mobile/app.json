{
  "expo": {
    "name": "Nemesis",
    "slug": "nemesis",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nemesis",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/b35d0bf1-8ca8-41a9-97e8-d2420987745c"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.enternemesis.mobile",
      "buildNumber": "22",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Nemesis accesses your photo library only if you choose to add or attach an image in a chat.",
        "NSPhotoLibraryAddUsageDescription": "Nemesis saves an image to your photo library only if you choose to save it."
      }
    },
    "android": {
      "package": "com.enternemesis.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0e0e0e"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Nemesis uses the camera only to scan the pairing code shown on your Mac."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Nemesis uses the microphone only when you tap the mic to dictate a message.",
          "speechRecognitionPermission": "Nemesis turns what you say into text in the chat box when you tap the mic."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      "./plugins/withFluidAudioPod.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b35d0bf1-8ca8-41a9-97e8-d2420987745c"
      }
    },
    "owner": "axelgalvez11"
  }
}
