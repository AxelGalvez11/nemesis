# Dependencies
# Both forms on purpose. "node_modules/" matches a DIRECTORY only, so a symlink
# named node_modules slips straight past it — which is how one got committed in
# e25e42f and made every fresh checkout fail `pnpm install` with ELOOP, because
# the link resolved to its own path.
node_modules/
node_modules
.pnpm-store/

# Build / cache
.next/
.turbo/
dist/
build/
*.tsbuildinfo
.playwright-mcp/
.superpowers/

# Expo / React Native
.expo/
*.jks
*.p8
*.p12
*.mobileprovision
*.orig.*

# Env / secrets
.env
.env.*
!.env.example

# Supabase
supabase/.temp/
supabase/.branches/

# OS / editor
.DS_Store
*.log
.idea/
.vscode/
.vercel

# graphify knowledge-graph output (generated cache, never source)
graphify-out/
.env*

# Dead prototype, still on disk. Ignored here so EAS never uploads it, and
# excluded from the workspace in pnpm-workspace.yaml so pnpm never counts it —
# both are needed, because pnpm globs the filesystem rather than git.
apps/desktop-agent/

# Built by apps/web/scripts/build-parse-thread.mjs on prebuild. A 1 MB generated
# bundle in git would be reviewed by nobody and would drift from its source.
apps/web/workers/
