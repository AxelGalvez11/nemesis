# Dependencies
# Both forms on purpose. "node_modules/" matches a DIRECTORY only, so a symlink
# named node_modules slips straight past it — which is how one got committed in
# e25e42f and made every fresh checkout fail `pnpm install` with ELOOP, because
# the link resolved to its own path.
node_modules/
node_modules
.pnpm-store/

# Build / cache
.next/
.turbo/
dist/
build/
*.tsbuildinfo
.playwright-mcp/
.superpowers/

# Expo / React Native
.expo/
*.jks
*.p8
*.p12
*.mobileprovision
*.orig.*

# Env / secrets
.env
.env.*
!.env.example

# Supabase
supabase/.temp/
supabase/.branches/

# OS / editor
.DS_Store
*.log
.idea/
.vscode/
.vercel

# graphify knowledge-graph output (generated cache, never source)
graphify-out/
.env*

# Dead prototype, still on disk. Ignored here so EAS never uploads it, and
# excluded from the workspace in pnpm-workspace.yaml so pnpm never counts it —
# both are needed, because pnpm globs the filesystem rather than git.
apps/desktop-agent/

# Built by apps/web/scripts/build-parse-thread.mjs on prebuild. A 1 MB generated
# bundle in git would be reviewed by nobody and would drift from its source.
apps/web/workers/

# Nemesis Lab bench results — measured on one machine, never shared as if they were
# a fact about the product. The TTS bake-off writes ratings here; promotion into
# `speech-route.ts` stays a deliberate commit.
.nemesis-lab/

# The visual gallery writes its sheet next to the script it is generated by.
apps/web/gallery.png
apps/web/gallery.html

# Nemesis Lab (localhost-only internal testing environment).
# The Lab's throwaway learner credentials. Never committed: it is a password for a
# `@nemesis.test` account on one developer's machine.
apps/web/.lab/
package-lock.json

# 🔴 THE OWNER'S OWN COURSE MATERIAL, COPIED IN SO THE CANVAS HARNESS CAN BE REVIEWED ON REAL FILES
# (owner 2026-09-06: "use actual school pdf, pptx, docx, from my desktop for the canvas"). It is his
# university's copyrighted material and this repository is PUBLIC, so the files stay on his machine
# and only the fixture rows that name them are committed.
apps/web/public/dev-fixtures/
