# PharmaBro environment — copy to .env.local and fill. NEVER commit real values.

# ── Embeddings (Layer A) ── REQUIRED for the Phase-0 smoke test ──
# Locked at 1024-dim (see IMPLEMENTATION_PLAN.md §6). Primary → fallback order:
VOYAGE_API_KEY=              # primary: voyage-3-large @ 1024-dim
# COHERE_API_KEY=            # fallback: embed-v4.0 (output_dimension=1024)
# OPENAI_API_KEY=            # last resort: text-embedding-3-large @ 1024

# ── Source providers (Layer A ingest) ── optional, recommended (raise rate limits) ──
OPENFDA_API_KEY=
NCBI_API_KEY=                # PubMed / NCBI E-utilities

# ── Supabase (PharmaBro project ref: qyjmivntajbigjswhahb) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # service-role: Layer-A writes only. NEVER ship in the app bundle.
SUPABASE_DB_PASSWORD=        # used by `supabase link` / `supabase db push`

# ── Observability (optional; functions/_shared/sentry.ts no-ops when unset) ──
SENTRY_DSN=
