# Nemesis — environment reference. Copy to .env.local and fill. NEVER commit real values.
#
# ── READ THIS FIRST: THERE ARE THREE PLACES, AND PUTTING A KEY IN THE WRONG ONE FAILS SILENTLY ──
#
#   1. VERCEL      — the website's own server (apps/web). Set in the Vercel dashboard, or here in
#                    .env.local for local development.
#   2. SUPABASE    — the ~22 edge functions (supabase/functions). Set with
#                    `supabase secrets set NAME=value`. These are a SEPARATE store: a key in Vercel
#                    is invisible to an edge function and vice versa.
#   3. EXPO / EAS  — the phone app (apps/mobile). Only EXPO_PUBLIC_* exists there, and every one of
#                    them SHIPS INSIDE THE APP BUNDLE. Never put a secret in that group.
#
# A missing key is almost always a named refusal rather than a crash — the feature reports itself as
# unconfigured and the rest of the app keeps working. The two exceptions are Supabase and the model
# key: without those there is no product.
#
# Anything marked REQUIRED has to be set for that surface to work at all.


# ═══════════════════════════════════════════════════════════════════════════════════════════════
#  1. VERCEL — the web app's server (apps/web)
# ═══════════════════════════════════════════════════════════════════════════════════════════════

# ── Supabase connection ── REQUIRED. Without these the web app boots into preview mode with no
#    login, no library and no saved work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Bypasses row-level security, so it must never reach the browser bundle.
# `SUPABASE_SERVICE_KEY` is accepted as an alias; set one, not both.
SUPABASE_SERVICE_ROLE_KEY=

# ── The model ── REQUIRED for the balance-alert cron. Ordinary chat and teaching reach DeepSeek
#    through the `nemesis-llm` edge function, so the key that matters for those is the Supabase one.
DEEPSEEK_API_KEY=
# Emails you when the DeepSeek account balance drops below the threshold (default 5 USD).
DEEPSEEK_BALANCE_ALERT_USD=
BALANCE_ALERT_EMAIL=

# ── Reading documents ── all optional; each absence costs one layer of reading quality.
# Mistral OCR reads pages that are scans or photographs with no text layer underneath. Without it,
# such pages come back empty and the rest of the document still parses.
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=              # default: mistral-ocr-latest
# LlamaParse — the second reader, for layouts Mistral struggles with.
LLAMAPARSE_API_KEY=
LLAMAPARSE_TIER=
LLAMAPARSE_VERSION=
# Gemini looks at FIGURES and at photographed handwriting. Never used as a chat model here.
# `GOOGLE_GENERATIVE_AI_API_KEY` is accepted as an alias.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=

# ── Speech ── Azure owns the language-learning lane: speaking in a chosen accent, and scoring a
#    learner's pronunciation word by word. Nothing else here can do the scoring.
#    🔴 The region is interpolated into every Azure hostname, so it is shape-checked at runtime.
#    Lowercase letters, optionally ending in a digit — e.g. eastus, westeurope, uksouth.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Live transcription in the browser (recording a lecture).
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_SPEECH_MODEL=        # default: universal-streaming-multilingual

# ── Billing (Stripe, web only — the phone uses RevenueCat) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_NEMESIS_MONTHLY_PRICE_ID=
STRIPE_NEMESIS_ANNUAL_PRICE_ID=
STRIPE_PLUS_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_MAX_PRICE_ID=
STRIPE_MAX_LEGACY_PRICE_IDS=    # comma-separated; grandfathered subscribers
STRIPE_ALLOW_LIVE=              # "true" to permit live-mode keys
STRIPE_ALLOW_TEST_BILLING=      # "true" to permit test-mode keys

# ── Email and scheduled work ──
RESEND_API_KEY=
EMAIL_FROM=                     # default: Nemesis <support@enternemesis.com>
CRON_SECRET=                    # shared secret the Vercel cron routes require
DOCUMENT_WORKER_SECRET=         # shared secret the document parse worker requires

# ── Public URLs and feature flags (all shipped to the browser) ──
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_LANDING_URL=        # default: https://www.enternemesis.com
NEXT_PUBLIC_AUTH_PROVIDERS=     # comma-separated OAuth providers to offer
NEXT_PUBLIC_TURNSTILE_SITE_KEY= # Cloudflare Turnstile, for sign-up
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=       # default: https://us.i.posthog.com
NEXT_PUBLIC_STREAMING=          # "true" to stream answers as they are written
NEXT_PUBLIC_ENGINE_VISUALS=
NEXT_PUBLIC_DELIVERABLES_ON_COMMAND=
NEXT_PUBLIC_TEACHING_EXPERIMENT_STARTED_AT=

# ── Academic sources read from the web app ──
NCBI_API_KEY=                   # PubMed / NCBI E-utilities — raises the rate limit
OPENALEX_MAILTO=                # a contact address; OpenAlex asks for one
UNPAYWALL_EMAIL=                # same, for Unpaywall


# ═══════════════════════════════════════════════════════════════════════════════════════════════
#  2. SUPABASE SECRETS — the edge functions (supabase/functions)
#     Set with: supabase secrets set NAME=value
#
#     🔴 SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected automatically
#     into every edge function by the platform. Do NOT set them by hand.
# ═══════════════════════════════════════════════════════════════════════════════════════════════

# ── Models ── DEEPSEEK_API_KEY is REQUIRED; it is what answers, teaches and marks. The rest are
#    alternates that are wired and idle: a request is routed to one by the model name it asks for.
DEEPSEEK_API_KEY=
GLM_API_KEY=                    # Z.ai — the premium "highest effort" tier
GLM_MODEL=                      # default: glm-5.2
QWEN_API_KEY=                   # Alibaba DashScope (alias: DASHSCOPE_API_KEY)
QWEN_BASE_URL=
QWEN_MODEL=                     # default: qwen3.7-plus
KIMI_API_KEY=                   # Moonshot (alias: MOONSHOT_API_KEY)
KIMI_BASE_URL=
KIMI_MODEL=                     # default: kimi-k3
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
# A separate OpenAI-compatible endpoint used by the research pipeline.
LLM_API_KEY=
LLM_BASE_URL=
LLM_CLASSIFY_MODEL=
LLM_GENERATE_MODEL=
LLM_RESEARCH_MODEL=
LLM_SCOPE_MODEL=
LLM_VERIFY_MODEL=
# Optional dedicated reasoning endpoint, when it differs from the one above.
REASONER_API_KEY=
REASONER_BASE_URL=
REASONER_MODEL_PATTERN=

# ── Live web search ── tried in this order; each falls through to the next when unset or refused.
#    Prices are per search, and one search bills the same however many pages come back.
BRAVE_API_KEY=                  # ~$0.005 — the primary (alias: BRAVE_SEARCH_API_KEY)
LINKUP_API_KEY=                 # ~$0.005 — second
TAVILY_API_KEY=                 # ~$0.016 — third
FIRECRAWL_API_KEY=              # ~$0.010 — last, and the page-fetcher
# An optional private reconnaissance endpoint, off unless all three are set.
WEB_RECON=
WEB_RECON_API_URL=
WEB_RECON_API_KEY=

# ── Speech and audio ──
XAI_API_KEY=                    # reads Canvas answers aloud, and one transcription path
GROQ_API_KEY=                   # the second transcriber behind AssemblyAI
ASSEMBLY_API_KEY=               # 🔴 NOT "ASSEMBLYAI_API_KEY" here — the Supabase secret is spelled
                                #    without the AI. The AI-suffixed name is read as a fallback.
GEMINI_API_KEY=                 # image generation in nemesis-media
GEMINI_IMAGE_MODEL=

# ── Search over the learner's own library (embeddings and reranking) ──
VOYAGE_API_KEY=                 # primary: voyage-3-large @ 1024 dimensions
COHERE_API_KEY=                 # fallback: embed-v4.0 (output_dimension=1024)
OPENAI_API_KEY=                 # last resort: text-embedding-3-large @ 1024
# 🔴 The dimension is locked at 1024. A model at a different width cannot be compared against
#    vectors already stored, so changing it silently ruins every existing search result.

# ── Academic and reference sources (all optional; they raise rate limits or unlock a connector) ──
OPENFDA_API_KEY=
NCBI_API_KEY=
OPENALEX_API_KEY=
OPENALEX_MAILTO=
SEMANTIC_SCHOLAR_API_KEY=
BIOGRID_ACCESS_KEY=
TOXICOLOGY_SOURCE_URL=
TOXICOLOGY_SOURCE_TITLE=
TOXICOLOGY_SOURCE_TEXT=

# ── Email, payments, telemetry ──
RESEND_API_KEY=                 # research digests and watch alerts
RESEND_FROM=
REVENUECAT_WEBHOOK_AUTH=        # verifies the iPhone purchase webhook
POSTHOG_KEY=
POSTHOG_HOST=
SENTRY_DSN=                     # no-ops entirely when unset
SENTRY_ENV=
SENTRY_RELEASE=

# ── Behaviour switches (unset is the safe default in every case) ──
APP_URL=                        # canonical origin for links in outbound email
WEB_ALLOWED_ORIGINS=            # comma-separated CORS allow-list
SUPABASE_SECRET_KEYS=           # comma-separated device-key salts
ASK_STREAMING=
DYNAMIC_INTENT=
LANE_ROUTER=
GENERAL_ASSISTANT_LANE=
WEB_IN_CHAT=
PRO_HIGH_MODE=
GLM_HIGH_MODE=
DEEP_RESEARCH_AGENTIC=
DEEP_RESEARCH_WIDE=
DEEP_AGENTIC_ALLOW_LOW_TRUST=
SCIENCE_SEARCH_ENABLED=
SCIENCE_CONNECTORS=
MEDICAL_QUERY_EXPANSION=
SYMPTOM_RETRIEVAL_BREADTH=
QUERY_NORMALIZE=
RR_MODEL=
LIVE_SOURCES=


# ═══════════════════════════════════════════════════════════════════════════════════════════════
#  3. EXPO / EAS — the phone app (apps/mobile)
#
#  🔴 EVERY VALUE HERE SHIPS INSIDE THE APP BUNDLE AND CAN BE READ BY ANYONE WHO DOWNLOADS IT.
#     Only publishable keys belong in this section. The phone reaches every model, search and
#     speech provider through Supabase edge functions precisely so no provider key is ever here.
# ═══════════════════════════════════════════════════════════════════════════════════════════════

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY= # RevenueCat's PUBLIC SDK key — safe to ship, by design
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=


# ═══════════════════════════════════════════════════════════════════════════════════════════════
#  4. LOCAL ONLY — maintenance scripts and developer pages. Nothing in production reads these.
# ═══════════════════════════════════════════════════════════════════════════════════════════════

SUPABASE_DB_PASSWORD=           # `supabase link` and `supabase db push`
SB_URL=                         # short aliases some scripts accept for the two above
SERVICE_KEY=
ANON_KEY=
TEST_USER_JWT=                  # a signed-in token for the acceptance scripts
# The /api/dev TTS comparison page, and nothing else. Not part of the product.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=
ELEVENLABS_VOICE_ID=
CARTESIA_API_KEY=
CARTESIA_MODEL=
CARTESIA_VERSION=
CARTESIA_VOICE_ID=
XAI_TTS_VOICE=

# ── Connected apps (Composio) ───────────────────────────────────────────────
# Brokers OAuth to Google Drive, Gmail and Calendar so Nemesis can read a
# learner's own lectures, mail and dates without ever holding their password.
#
# 🔴 ACCOUNT-WIDE, AND SERVER-SIDE ONLY. This one key can act for EVERY
# connected user, so it must never be prefixed NEXT_PUBLIC_ and never reach the
# browser bundle. apps/web/app/api/composio/route.ts is the only file that reads
# it, and composio-door.test.ts fails if the client ever names it.
#
# 🔴 OPTIONAL. Absent ⇒ /api/composio answers {configured:false}, Settings says
# connections are not set up, and the product behaves exactly as it did before
# Composio existed. Nothing else changes.
COMPOSIO_API_KEY=
# One auth-config id per offered app, created once in the Composio dashboard.
# Named by app slug, uppercased: COMPOSIO_AUTH_<APP>.
COMPOSIO_AUTH_GOOGLEDRIVE=
COMPOSIO_AUTH_GMAIL=
COMPOSIO_AUTH_GOOGLECALENDAR=
COMPOSIO_AUTH_GOOGLEDOCS=
